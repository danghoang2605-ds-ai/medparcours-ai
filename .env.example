# Copy to ".env" and fill in your keys. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (auth + patient storage) ──────────────────────────────────────
# Required for doctor login and saving patient records.
# Leave blank to run in analysis-only mode (no login, no persistence).
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
PATIENT_HASH_SALT=

# ─── Turso / libSQL (primary patient database, optional) ────────────────────
# If blank, patient storage falls back to Supabase.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
