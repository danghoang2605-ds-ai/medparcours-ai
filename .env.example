# Copy file này thành ".env" rồi điền API key thật trước khi chạy docker-compose.
# KHÔNG commit file .env thật lên Git (đã có trong .gitignore).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── VNPT AI (SmartReader) — "động cơ kép", TÙY CHỌN ─────────────────────
# Nếu để trống, hệ thống tự động dùng Claude Vision như trước (không lỗi,
# không cần cấu hình gì thêm) — xem vnpt_client.py và main.py để biết logic
# fallback. Chỉ cần điền nếu muốn ưu tiên SmartReader làm OCR chính.
VNPT_TOKEN_ID=
VNPT_TOKEN_KEY=
VNPT_ACCESS_TOKEN=
# mac-address: xuất hiện trong Postman collection thật của BTC nhưng chưa
# rõ có bắt buộc hay không — để trống dùng giá trị mặc định 00:00:00:00:00:00
VNPT_MAC_ADDRESS=
# Domain mặc định https://api.idg.vnpt.vn nếu để trống
VNPT_API_DOMAIN=

# ─── VNPT Smartbot FAQ (module hỗ trợ, ĐỘC LẬP với MedAmi lâm sàng) ───────
# Endpoint đã xác thực (assistant-stream.vnpt.vn/v1/conversation), dùng
# chung VNPT_TOKEN_ID/VNPT_TOKEN_KEY/VNPT_ACCESS_TOKEN ở trên. Chỉ còn thiếu
# bot_id — PHẢI tạo bot trên console-smartbot.vnpt.vn trước (xem
# Hướng_dẫn_khởi_tạo_kịch_bản.pptx), rồi điền vào đây. Để trống -> widget
# FAQ tự hiện "đang bảo trì", KHÔNG lỗi, KHÔNG crash.
VNPT_FAQ_BOT_ID=

# ─── VNPT Smartbot lâm sàng (chat_smartbot — dùng cho /chat MedAmi) ───────
# CỐ Ý CHƯA DÙNG ĐƯỢC — quyết định kiến trúc: Smartbot dạng kịch bản/FAQ
# không phù hợp làm lõi suy luận lâm sàng động trên hồ sơ bệnh nhân (xem
# phân tích chi tiết trong lịch sử trao đổi). /chat vẫn dùng Claude, không
# cần biến môi trường nào ở đây.

# ─── VNPT SmartVoice (TTS/STT) — ĐÃ TRIỂN KHAI THẬT ───────────────────────
# XÁC NHẬN THẬT từ tài liệu BTC (2 file "Thông tin token" riêng biệt cho
# TTS và STT, Token-id 2 bên khác nhau) — SmartVoice dùng BỘ TOKEN RIÊNG,
# KHÔNG dùng chung với SmartReader như giả định ban đầu. Điền đúng giá trị
# từ file "Thông tin token" tương ứng trong tài liệu BTC vào 6 biến dưới
# đây. Nếu để trống, TỰ ĐỘNG rơi về dùng bộ VNPT_TOKEN_ID/KEY/ACCESS_TOKEN
# chung ở trên (an toàn — vẫn chạy được, chỉ có thể lỗi 401 nếu bộ chung
# không có quyền gọi SmartVoice).
VNPT_TTS_TOKEN_ID=
VNPT_TTS_TOKEN_KEY=
VNPT_TTS_ACCESS_TOKEN=
VNPT_STT_TOKEN_ID=
VNPT_STT_TOKEN_KEY=
VNPT_STT_ACCESS_TOKEN=
# Nếu VNPT lỗi (token sai/hết hạn/mất mạng), /voice/tts và /voice/stt tự
# trả fallback an toàn (use_local_tts, STT_FALLBACK), Frontend tự chuyển
# sang Web Speech API tiếng Việt của trình duyệt — không bao giờ crash.

# ─── VNPT eKYC (OCR CCCD + Nhận diện khuôn mặt) — ĐÃ TRIỂN KHAI THẬT ──────
# Xác thực từ "API eKYC App/Web - Hackathon.postman_collection.json" — VNPT
# eKYC gồm 3 API chính (domain giống hệt SmartReader: api.idg.vnpt.vn):
#   1. OCR CCCD/CMND       -> POST /ai/v1/ocr/id             (ĐÃ nối, vnpt_client.ocr_id_card)
#   2. Nhận diện khuôn mặt -> POST /ai/v1/face/liveness       (ĐÃ nối, vnpt_client.face_liveness)
#   3. So khớp khuôn mặt   -> POST /ai/v1/face/compare        (CHƯA nối — so khớp ảnh CCCD với
#      ảnh mặt trực tiếp để xác nhận ĐÚNG DANH TÍNH, khác liveness chỉ xác định "có phải người
#      thật" mà không xác nhận là AI. Có thể bổ sung sau nếu cần mức xác thực chặt hơn.)
# Điền 3 biến dưới đây theo đúng "Thông tin token" trong tài liệu BTC (bộ RIÊNG, không dùng
# chung SmartReader) — để trống thì tự rơi về bộ VNPT_TOKEN_ID/KEY/ACCESS_TOKEN chung ở trên.
VNPT_EKYC_TOKEN_ID=
VNPT_EKYC_TOKEN_KEY=
VNPT_EKYC_ACCESS_TOKEN=
# eKYC có kiến trúc xác thực KHÁC HẲN SmartReader/TTS/STT — xác nhận thật
# qua lỗi thực tế "401 No permission to access api" khi dùng access_token
# tĩnh ở trên. Tài liệu BTC có riêng mục lấy access_token qua OAuth
# (username/password), gọi POST /auth/oauth/token trước khi dùng API eKYC.
# XÁC NHẬN THẬT: BTC cấp tài khoản riêng cho eKYC qua email thông báo Vòng 2
# (team.01@vnptai.io kiểu vậy) — KHÁC với 3 biến VNPT_TOKEN_ID/KEY/
# ACCESS_TOKEN chung. Điền vào đây — hệ thống TỰ ĐỘNG dùng OAuth thay vì
# access_token tĩnh. Để trống nếu chưa có (vẫn thử access_token tĩnh như
# cũ, phòng trường hợp không cần OAuth thật).
VNPT_EKYC_USERNAME=
VNPT_EKYC_PASSWORD=
VNPT_EKYC_CLIENT_ID=clientapp
# "password" là giá trị CỐ ĐỊNH ghi thẳng trong template Postman mẫu của
# BTC — không phải secret riêng từng đội, để trống sẽ tự dùng đúng giá trị
# này, không cần điền.
VNPT_EKYC_CLIENT_SECRET=
# Tóm tắt cuộc họp/hội chẩn (eval-emotion-service) — domain path KHÁC hẳn
# STT thường (stt-service), khả năng cao có bộ token riêng. Để trống sẽ
# tự rơi về bộ STT_TOKEN, rồi về bộ chung nếu STT_TOKEN cũng trống.
VNPT_SUMMARY_TOKEN_ID=
VNPT_SUMMARY_TOKEN_KEY=
VNPT_SUMMARY_ACCESS_TOKEN=
# Lỗi OCR/Liveness KHÔNG được âm thầm fallback giả thành công (khác TTS/STT) — trả lỗi rõ
# ràng cho bác sĩ, vì đây là bước liên quan xác thực, không nên tạo cảm giác an toàn giả.

# ─── VNPT iSense — Tóm tắt hội chẩn bằng giọng nói — ĐÃ TRIỂN KHAI THẬT ───
# Endpoint /eval-emotion-service/v1/conversation/summary-meeting — "2 trong 1" (VNPT tự làm
# STT + tóm tắt trong 1 lần gọi), dùng chung bộ VNPT_STT_TOKEN_ID/KEY/ACCESS_TOKEN ở trên
# (không cần biến riêng). Nếu VNPT lỗi -> tự động STT thật riêng rồi Claude tóm tắt từ ĐÚNG
# transcript đó (không hardcode nội dung y khoa giả) -> trả kèm "source":"CLAUDE_FALLBACK".
