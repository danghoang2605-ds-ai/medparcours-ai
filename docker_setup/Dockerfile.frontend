# Frontend: build the static site with the same script as GitHub Pages, serve with nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm install --no-save esbuild@0.27.7 react@19.2.6 react-dom@19.2.6
# Point the browser at the local backend container.
ENV MEDIFLOW_API_URL=http://localhost:8000
RUN node scripts/build.mjs

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
