FROM node:20-slim AS build

WORKDIR /app

RUN npm install esbuild@0.27.7 react@19.2.6 react-dom@19.2.6

COPY . .

# Place mount.jsx next to App.jsx (entry point)
COPY docker_setup/mount.jsx ./mount.jsx

RUN npx esbuild ./mount.jsx \
    --bundle \
    --loader:.jsx=jsx \
    --jsx=automatic \
    --format=esm \
    --outfile=/app/mount.js \
    --minify


FROM nginx:alpine

COPY --from=build /app/mount.js /usr/share/nginx/html/mount.js
COPY docker_setup/index.html /usr/share/nginx/html/index.html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]